{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youbid-lol",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  "vars": {
    "APP_URL": "https://youbid.lol"
  },
  "routes": [
    {
      "pattern": "youbid.lol/*",
      "zone_name": "youbid.lol"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "youbid-lol",
      "database_id": "5fc1f229-ee89-42c9-8d44-fe7af9c0d15a",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RESOLVE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
